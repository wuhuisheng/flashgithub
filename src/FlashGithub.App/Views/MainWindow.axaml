<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FlashGithub.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="780" d:DesignHeight="700"
        x:Class="FlashGithub.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/app.ico"
        Width="780" Height="700"
        MinWidth="680" MinHeight="560"
        Title="FlashGithub — GitHub 网络加速">

    <Window.Styles>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="28,11" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1D4ED8" />
        </Style>
        <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1E40AF" />
        </Style>
        <Style Selector="Button.accent:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#93C5FD" />
        </Style>
        <Style Selector="Button.quiet">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#6B7280" />
        </Style>
        <Style Selector="Border.row">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,5" />
        </Style>
        <Style Selector="Border.row:pointerover">
            <!-- 半透明中性色：亮/暗主题下都只轻微变化，避免吞掉文字颜色 -->
            <Setter Property="Background" Value="#1E808080" />
        </Style>
    </Window.Styles>

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*,Auto,190,Auto" Margin="20,16,20,12">

        <!-- 顶部：状态 + 主开关（分两列，避免重叠） -->
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <!-- 状态点：加速中绿色，否则灰色 -->
                    <TextBlock Text="●" FontSize="14" VerticalAlignment="Center"
                               Foreground="#16A34A" IsVisible="{Binding IsAccelerating}" />
                    <TextBlock Text="●" FontSize="14" VerticalAlignment="Center"
                               Foreground="#9CA3AF" IsVisible="{Binding !IsAccelerating}" />
                    <TextBlock Text="{Binding StatusText}" FontSize="20" FontWeight="Bold" />
                </StackPanel>
                <TextBlock Text="{Binding CertStatusText}" Classes="muted" FontSize="12" Margin="22,0,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Classes="accent" Command="{Binding ToggleAccelerationCommand}"
                    IsEnabled="{Binding !IsBusy}"
                    VerticalAlignment="Center"
                    Content="{Binding ActionButtonText}" />
        </Grid>

        <!-- 提示条：提权 / hosts 残留 -->
        <StackPanel Grid.Row="1" Margin="0,12,0,0" Spacing="8">
            <Border IsVisible="{Binding NeedsElevation}"
                    Background="#FFFBEB" BorderBrush="#F59E0B" BorderThickness="1"
                    CornerRadius="8" Padding="12,8">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="⚠️" VerticalAlignment="Center" />
                    <TextBlock Text="监听 80/443 端口需要管理员权限。" VerticalAlignment="Center" />
                    <Button Classes="quiet" Command="{Binding RestartElevatedCommand}"
                            Content="以管理员身份重启" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border IsVisible="{Binding HasHostsResidue}"
                    Background="#FEF2F2" BorderBrush="#EF4444" BorderThickness="1"
                    CornerRadius="8" Padding="12,8">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="⚠️" VerticalAlignment="Center" />
                    <TextBlock Text="检测到上次未正常关闭的加速条目，正在影响正常上网。" VerticalAlignment="Center" />
                    <Button Classes="quiet" Command="{Binding RestoreResidueCommand}"
                            Content="还原 hosts" VerticalAlignment="Center" />
                    <Button Classes="quiet" Command="{Binding IgnoreResidueCommand}"
                            Content="忽略" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 域名列表 -->
        <Border Grid.Row="2" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8"
                Margin="0,14,0,0" Padding="4,2">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="10,8,10,6">
                    <TextBlock Text="加速域名" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                    <Button Classes="quiet" Command="{Binding EnableAllDomainsCommand}" Content="全选" />
                    <Button Classes="quiet" Command="{Binding DisableAllDomainsCommand}" Content="全不选" />
                    <Button Classes="quiet" Command="{Binding RefreshLatencyCommand}"
                            IsEnabled="{Binding !IsBusy}" Content="刷新测速" />
                </StackPanel>

                <ScrollViewer Padding="0,0,4,4">
                    <ItemsControl ItemsSource="{Binding Domains}" Margin="0,0,0,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DomainItemViewModel">
                                <Border Classes="row">
                                    <Grid ColumnDefinitions="28,*,80,34">
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}"
                                                  VerticalContentAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Domain}"
                                                   VerticalAlignment="Center" Margin="6,0,0,0" FontSize="13" />
                                        <TextBlock Grid.Column="2" Text="{Binding LatencyText}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   FontSize="12" Foreground="#6B7280" />
                                        <Button Grid.Column="3" Content="✕" Padding="4,0"
                                                HorizontalAlignment="Right"
                                                Foreground="#9CA3AF" Background="Transparent"
                                                IsVisible="{Binding CanRemove}"
                                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).RemoveDomainCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- 自定义域名 -->
        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,0">
            <TextBlock Grid.Column="0" Text="自定义域名:" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding NewDomain}" Margin="10,0,8,0"
                     PlaceholderText="输入域名后回车或点添加，例如 huggingface.co" />
            <Button Grid.Column="2" Command="{Binding AddDomainCommand}" Content="添加"
                    Padding="18,6" />
        </Grid>

        <!-- 日志 -->
        <Border Grid.Row="4" Margin="0,12,0,0"
                BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="2">
            <TextBox Text="{Binding LogText}" IsReadOnly="True"
                     TextWrapping="NoWrap" AcceptsReturn="True"
                     FontSize="12" FontFamily="Menlo,Consolas,monospace"
                     BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </Border>

        <TextBlock Grid.Row="5" Classes="muted" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                   Text="开启加速会修改系统 hosts 并需要信任本地根证书；关闭加速会自动还原。SSH（git@github.com）不走代理，请使用 HTTPS 克隆。" />
    </Grid>
</Window>
